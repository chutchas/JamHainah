# ---- LINE Messaging API (channel ของ OA) ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---- LINE Login + LIFF (คนละ channel กับข้างบน) ----
# LINE_LOGIN_CHANNEL_ID = ตัวเลขล้วน จาก LINE Login channel > Basic settings
# ใช้ verify idToken ของหน้า "รายการของฉัน" — ถ้าไม่ใส่ หน้านั้นจะขึ้น 401
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=
# LINE_LOGIN_CHANNEL_SECRET = Channel secret ของ LINE Login channel (คนละตัวกับบรรทัดบนสุด)
# ใช้ตอนแลก code เป็น id_token ของหน้าหลังบ้าน — ถ้าไม่ใส่ จะล็อกอินเข้าหลังบ้านไม่ได้
# และต้องไปใส่ Callback URL ในคอนโซลด้วย: <NEXT_PUBLIC_BASE_URL>/api/admin/callback
LINE_LOGIN_CHANNEL_SECRET=

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenAI (vision / OCR) ----
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# ---- Cron protection ----
# สุ่มด้วย: openssl rand -hex 32
CRON_SECRET=

# ---- หลังบ้าน ----
# ADMIN_LINE_USER_ID = LINE user id ของเจ้าของระบบ คั่นด้วย , ถ้ามีหลายคน
# เป็นทั้งปลายทางของรายงานประจำวัน และทางกลับเข้าบ้านเมื่อเผลอถอดสิทธิ์ตัวเอง
ADMIN_LINE_USER_ID=
# ADMIN_SESSION_SECRET = กุญแจเซ็นคุกกี้หลังบ้าน สุ่มด้วย: openssl rand -hex 32
# เปลี่ยนค่านี้ = ไล่ทุกคนออกจากระบบทันที
ADMIN_SESSION_SECRET=
